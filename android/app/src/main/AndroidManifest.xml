<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Google Play Billing (required for in-app purchases) -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Camera (pet photos / health records). Needed because the permission is
         declared: Android then requires a runtime grant before ACTION_IMAGE_CAPTURE. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- No media permission is declared on purpose. Picking an existing picture
         goes through the Android photo picker (ActivityResultContracts.PickVisualMedia,
         used by @capacitor/camera), which hands back a single URI the user chose
         and grants access to that URI alone — the app never gets to enumerate the
         gallery, so there is nothing to ask for. The plugin agrees: its "photos"
         permission alias declares an empty permission array, so READ_MEDIA_IMAGES
         was never requested at runtime even while it sat in this manifest.

         READ/WRITE_EXTERNAL_STORAGE are gone with it. They only ever covered the
         Camera plugin's saveToGallery option, which this app does not use.

         Keeping these out matters beyond tidiness: declaring READ_MEDIA_IMAGES
         forces the Photo and Video Permissions declaration form in Play Console
         and an ongoing justification of broad gallery access.

         The removals below are defensive — a merged dependency cannot put the
         permission back into the final manifest without this file changing. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Location (find nearby vet) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
