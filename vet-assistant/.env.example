# Clé API Google Gemini (https://aistudio.google.com/apikey).
# Sans clé, l'assistant tourne en mode démo (réponses FAQ par mots-clés).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

PORT=3000

# Jeton d'accès au tableau de bord /admin.html (obligatoire en production)
ADMIN_TOKEN=change-moi

# Optionnel : webhook appelé à chaque demande de RDV (Make, Zapier, n8n...)
# pour envoyer un email / SMS à la clinique.
NOTIFY_WEBHOOK_URL=

# Dossier de stockage des événements (JSON lines)
DATA_DIR=./data
